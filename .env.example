# 복사해서 .env로 쓰세요. .env는 커밋하지 않아요.
# 로컬 MySQL (docker-compose.yml). 3306을 다른 프로그램이 쓰고 있으면 MYSQL_PORT와 DB_URL 포트를 바꿔요.
MYSQL_PORT=3306
DB_URL='jdbc:mysql://localhost:3306/reeltrip?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=reeltrip
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT 서명 키 (32바이트 이상 무작위 문자열)
JWT_SECRET=

# Gemini (BE 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# CORS에 넣을 FE 배포 주소 (쉼표로 여러 개)
CORS_ALLOWED_ORIGINS=
