# 값은 배포 환경에서 준비해요. 이 파일을 그대로 배포하지 않아요.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DEV_LOGIN_ENABLED=false
ANALYSIS_ENABLED=true
MAPS_PERSIST_ENRICHMENT=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
GEMINI_MODEL=gemini-3-flash-preview
CORS_ALLOWED_ORIGINS=https://REPLACE_FE_HOST
SHARE_BASE_URL=https://REPLACE_FE_HOST
GCS_BUCKET=REPLACE_APPROVED_BUCKET
# DB_URL / DB_USERNAME / DB_PASSWORD / JWT_SECRET / GEMINI_API_KEY /
# GOOGLE_MAPS_API_KEY는 Secret Manager의 고정 버전을 연결해요.
# GCP_ACCESS_TOKEN·JSON 키 파일은 Cloud Run에 등록하지 않아요.
